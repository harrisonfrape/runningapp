# ---- app ----
# Public base URL. Must be the exact origin the OAuth redirect URIs are
# registered against, and must be publicly reachable for webhooks to arrive.
APP_URL=http://localhost:3000
# 32+ random characters. Signs the session cookie; required in production.
APP_SECRET=
# ---- Database (Turso / libSQL) ----
# Required. On Vercel the filesystem is read-only and ephemeral, so production
# must point at a hosted Turso database, not a file:
#   TURSO_DATABASE_URL=libsql://<your-db>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create <your-db>`>
# For local development a file URL works and needs no auth token:
#   TURSO_DATABASE_URL=file:./data/stride.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Strava (https://www.strava.com/settings/api) ----
# Set the app's "Authorization Callback Domain" to APP_URL's host.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any string you choose; Strava echoes it back when validating the webhook.
STRAVA_VERIFY_TOKEN=stride-verify
# How far back to import on first connect.
STRAVA_HISTORY_DAYS=180

# ---- Garmin (https://developerportal.garmin.com — Connect Developer Program) ----
# Health API access requires an approved developer account. Register
# APP_URL/api/garmin/callback as the OAuth redirect URI and
# APP_URL/api/garmin/webhook as the push notification endpoint.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# ---- coach ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- defaults for a new athlete ----
DEFAULT_RACE_NAME=London Marathon
DEFAULT_RACE_DATE=2027-04-26
DEFAULT_GOAL_SECONDS=12600
# Fallback max HR when no watch data exists yet.
DEFAULT_MAX_HR=192

# Local development only: lets onboarding continue without both providers connected.
ALLOW_SKIP_CONNECT=false
